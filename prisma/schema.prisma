// Remotify — Neon PostgreSQL schema (Prisma)
// Secrets stay in runtime env; never hardcode connection strings here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Scraped remote roles plus downstream AI match metadata.
model Job {
  id              String    @id @default(cuid())
  title           String
  company         String
  location        String
  isRemote        Boolean   @default(true)
  remoteToken     String? // e.g. "USA Remote", "Worldwide Remote"
  salary          String?
  currency        String?
  employmentType  String?
  experience      String?
  description     String
  skills          String[]  @default([])
  applyUrl        String
  companyUrl      String?
  sourceWebsite   String
  postedDate      DateTime?
  scrapedAt       DateTime  @default(now())

  // AI analysis payload (Gemini strategy layer)
  aiScore         Float?
  aiMatchedSkills String[]  @default([])
  aiMissingSkills String[]  @default([])
  aiReason        String?
  aiRawResponse   Json?

  isNotified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([applyUrl])
  @@index([company, title])
  @@index([aiScore])
  @@index([sourceWebsite])
  @@index([scrapedAt])
  @@map("jobs")
}

/// Flexible global key-value configuration (avoids fractured unversioned columns).
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Pipeline operational flags and execution telemetry markers.
model SchedulerConfig {
  id              String    @id @default(cuid())
  name            String    @unique @default("default")
  isEnabled       Boolean   @default(false)
  isRunning       Boolean   @default(false)
  cronExpression  String?
  targetHourUtc   Int?
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastRunStatus   String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("scheduler_configs")
}

/// Per-execution metrics: timing, parse counts, dedup analytics, errors, notifications.
model RunHistory {
  id                  String   @id @default(cuid())
  startedAt           DateTime @default(now())
  finishedAt          DateTime?
  durationMs          Int?
  status              String   @default("running") // running | success | partial | failed
  sourcesTargeted     Int      @default(0)
  jobsParsed          Int      @default(0)
  jobsDeduplicated    Int      @default(0)
  jobsProcessed       Int      @default(0)
  jobsMatched         Int      @default(0)
  notificationsSent   Int      @default(0)
  errorCount          Int      @default(0)
  errors              Json?
  notificationLog     Json?
  metrics             Json?
  createdAt           DateTime @default(now())

  @@index([startedAt])
  @@index([status])
  @@map("run_histories")
}

/// Canonical candidate identity used for AI matching + master resume generation.
model CandidateProfile {
  id              String   @id @default(cuid())
  slug            String   @unique
  isActive        Boolean  @default(true)
  fullName        String
  headline        String?
  summary         String?
  location        String?
  email           String?
  phone           String?
  websiteUrl      String?
  portfolioUrl    String?
  githubUrl       String?
  linkedinUrl     String?
  yearsExperience Float?
  availability    String?
  workAuth        String[] @default([])
  targetRoles     String[] @default([])
  targetCompanies String[] @default([])
  avoidRoles      String[] @default([])
  /// Master resume template config, stretch rules, positioning notes.
  masterResume    Json?
  /// Raw ingested snapshot for audit / re-seed.
  rawProfile      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skills       ProfileSkill[]
  projects     ProfileProject[]
  experiences  ProfileExperience[]
  education    ProfileEducation[]
  priorities   ProfilePriority[]
  sources      ProfileSource[]

  @@index([isActive])
  @@map("candidate_profiles")
}

model ProfileSkill {
  id           String           @id @default(cuid())
  profileId    String
  profile      CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  category     String?
  proficiency  String?
  years        Float?
  keywords     String[]         @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([profileId, name])
  @@index([category])
  @@map("profile_skills")
}

model ProfileProject {
  id          String           @id @default(cuid())
  profileId   String
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  tagline     String?
  description String?
  role        String?
  status      String?
  featured    Boolean          @default(false)
  impact      String?
  stack       String[]         @default([])
  highlights  String[]         @default([])
  liveUrl     String?
  repoUrl     String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([profileId, slug])
  @@index([featured, sortOrder])
  @@map("profile_projects")
}

model ProfileExperience {
  id             String           @id @default(cuid())
  profileId      String
  profile        CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company        String
  title          String
  location       String?
  employmentType String?
  startDate      DateTime?
  endDate        DateTime?
  isCurrent      Boolean          @default(false)
  description    String?
  highlights     String[]         @default([])
  stack          String[]         @default([])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([profileId, isCurrent])
  @@map("profile_experiences")
}

model ProfileEducation {
  id          String           @id @default(cuid())
  profileId   String
  profile     CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  institution String
  degree      String?
  field       String?
  startYear   Int?
  endYear     Int?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("profile_education")
}

model ProfilePriority {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  key       String
  label     String
  weight    Int              @default(50)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([profileId, key])
  @@index([weight])
  @@map("profile_priorities")
}

model ProfileSource {
  id        String           @id @default(cuid())
  profileId String
  profile   CandidateProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type      String
  url       String?
  label     String?
  scrapedAt DateTime?
  raw       Json?
  createdAt DateTime         @default(now())

  @@index([type])
  @@map("profile_sources")
}
